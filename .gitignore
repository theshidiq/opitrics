# Secrets — never commit
.env
.env.local
*.key

# Data & caches — all regenerable, and the PNGs are chunky.
# The SQLite cache is the expensive one to lose (re-fetching costs
# YouTube quota), so back it up rather than relying on git.
data/cache/
data/output/*
!data/output/.gitkeep

# ...except the spec files, which are the one thing under data/ that is
# NOT regenerable: hand-typed manufacturer figures with their source
# URLs. Losing one means re-reading a catalogue, not re-running a stage.
!data/output/subjects/
data/output/subjects/*
!data/output/subjects/*/
data/output/subjects/*/*
!data/output/subjects/*/specs.json

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/

# Model caches
.cache/

# macOS
.DS_Store

# Remotion
remotion/node_modules/
remotion/out/
remotion/public/
remotion/props.json

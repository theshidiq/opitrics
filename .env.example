# ─────────────────────────────────────────────────────────────
# Opitrics — opinion metrics
# Configuration template
#
# Copy this file to `.env` and fill in your keys.
# `.env` is git-ignored and must never be committed.
# ─────────────────────────────────────────────────────────────

# ── Required ────────────────────────────────────────────────

# YouTube Data API v3
# Get one: console.cloud.google.com → new project
#          → enable "YouTube Data API v3" → Credentials → API key
# Free tier: 10,000 quota units/day (search costs 100, comment
# fetches cost ~1 per 100 comments).
YOUTUBE_API_KEY=

# ── LLM provider ────────────────────────────────────────────
# Used only at the narrative stage: ~30 cluster summaries are
# sent out for theme naming and write-up. Raw comments never
# leave your machine.
#
# Set LLM_PROVIDER to "deepseek" or "openrouter", then fill in
# the matching key below.

LLM_PROVIDER=deepseek

# --- if LLM_PROVIDER=deepseek ---
# Get one: platform.deepseek.com → API keys
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# --- if LLM_PROVIDER=openrouter ---
# Get one: openrouter.ai → Keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=deepseek/deepseek-v4-flash

# --- if LLM_PROVIDER=ollama (fully offline fallback) ---
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b

# ── Publishing (optional) ───────────────────────────────────
# Only needed for `scripts/publish.py`. X moved to pay-per-use in
# Feb 2026: ~$0.015 per post, ~$0.20 if the post contains a link.
# developer.x.com → create an app → set permissions to Read and Write
# → generate API key/secret and an access token/secret.

X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# ── TikTok (optional) ───────────────────────────────────────
# developers.tiktok.com → Manage apps → add the Content Posting API.
#
# Read this before wiring it up: until TikTok audits the app, every
# video it posts is forced to private however the request is written,
# and at most five users may post per 24 hours. The audit takes 2-4
# weeks and requires the posting UI to show the creator's username and
# avatar before publishing.
#
# The access token is short-lived; the refresh token is what to store.

TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=

# ── Meta / Instagram Reels (optional) ───────────────────────
# developers.facebook.com → create app → add Instagram Graph API.
#
# Needs an Instagram Business or Creator account linked to a Facebook
# Page, plus App Review for instagram_content_publish before it serves
# anyone outside your 25 test users. Review takes 2-4 weeks.
#
# Instagram does NOT accept an uploaded file: it fetches a public URL,
# so the short has to be reachable from the internet at publish time.
# Limit is 25 published posts per account per 24 hours, shared with
# Stories.

META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
# instagram.com → your business account → the numeric IG user id
INSTAGRAM_USER_ID=
# Optional: cross-post to a Facebook Page
FACEBOOK_PAGE_ID=

# ── Voiceover (optional) ────────────────────────────────────
# Only needed for `scripts/short.py`. Voice and sound effects are
# commercially licensed on any paid ElevenLabs plan; free-tier output
# is not, and cannot be used in monetised content.
# Music is NOT generated here — generated music carries stricter terms.
# Supply your own track with --music from a library with clear rights.

ELEVENLABS_API_KEY=
# elevenlabs.io → Voices → any voice → copy its ID
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2

# ── Local models (auto-downloaded on first run, no keys) ────
# Cached to ~/.cache/huggingface — roughly 4GB total.

EMBEDDING_MODEL=BAAI/bge-m3
SENTIMENT_MODEL=cardiffnlp/twitter-xlm-roberta-base-sentiment
ZEROSHOT_MODEL=MoritzLaurer/mDeBERTa-v3-base-mnli-xnli
IRONY_MODEL=cardiffnlp/twitter-roberta-base-irony

# Torch device: "mps" (Apple silicon), "cuda", or "cpu"
TORCH_DEVICE=mps

# ── Tuning ──────────────────────────────────────────────────
# Defaults are sized for a 16GB M2 Air. Lower EMBED_BATCH_SIZE
# if you hit memory pressure or heavy thermal throttling.

EMBED_BATCH_SIZE=32
MIN_COMMENT_WORDS=4
MIN_CLUSTER_SIZE=15
SAMPLES_PER_CLUSTER=25
MAX_LLM_SUMMARIES=40

# ── Paths ───────────────────────────────────────────────────

DATABASE_PATH=data/cache/opitrics.db
OUTPUT_DIR=data/output
